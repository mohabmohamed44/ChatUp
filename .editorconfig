root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Matches .prettierrc: { singleQuote: true, printWidth: 100, trailingComma: "all" }
[*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}]
max_line_length = 100
